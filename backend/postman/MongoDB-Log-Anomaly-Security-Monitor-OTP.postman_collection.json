{
  "info": {
    "_postman_id": "b9d1c4e8-8c68-4ce0-9c94-8c4b4f6b8e91",
    "name": "MongoDB Log Anomaly & Security Monitor - OTP Auth Flow",
    "description": "Register, verify email OTP, login, resend verification code, forgot password, and reset password flow for the backend API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "email",
      "value": "you@example.com"
    },
    {
      "key": "username",
      "value": "testuser"
    },
    {
      "key": "password",
      "value": "TestPass123!"
    },
    {
      "key": "otpCode",
      "value": "123456"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "siemDataset",
      "value": "darkknight25/Advanced_SIEM_Dataset"
    }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"user\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "2. Verify Email OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/verify-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "verify-otp"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data.token) {",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data.token) {",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Resend Verification OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/send-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "send-otp"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "5. Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/forgot",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "forgot"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "6. Reset Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "reset-password"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\",\n  \"password\": \"NewPass123!\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "7. Get Current User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
      },
      {
        "name": "8. SIEM Dataset - Import (Admin)",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{token}}"
            }
          ],
          "url": {
            "raw": "{{baseUrl}}/siem-dataset/import",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "siem-dataset",
              "import"
            ]
          },
          "body": {
            "mode": "raw",
            "raw": "{\n  \"dataset\": \"{{siemDataset}}\",\n  \"reset\": true\n}"
          }
        },
        "response": []
      },
      {
        "name": "9. SIEM Dataset - Sync To Dashboard (Admin)",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{token}}"
            }
          ],
          "url": {
            "raw": "{{baseUrl}}/siem-dataset/sync",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "siem-dataset",
              "sync"
            ]
          },
          "body": {
            "mode": "raw",
            "raw": "{\n  \"dataset\": \"{{siemDataset}}\",\n  \"limit\": 5000,\n  \"reset\": false\n}"
          }
        },
        "response": []
      },
      {
        "name": "10. SIEM Dataset - List",
        "request": {
          "method": "GET",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer {{token}}"
            }
          ],
          "url": {
            "raw": "{{baseUrl}}/siem-dataset?dataset={{siemDataset}}&page=1&limit=100",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "siem-dataset"
            ],
            "query": [
              {
                "key": "dataset",
                "value": "{{siemDataset}}"
              },
              {
                "key": "page",
                "value": "1"
              },
              {
                "key": "limit",
                "value": "100"
              }
            ]
          }
        },
        "response": []
      },
      {
        "name": "11. SIEM Dataset - Stats",
        "request": {
          "method": "GET",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer {{token}}"
            }
          ],
          "url": {
            "raw": "{{baseUrl}}/siem-dataset/stats?dataset={{siemDataset}}",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "siem-dataset",
              "stats"
            ],
            "query": [
              {
                "key": "dataset",
                "value": "{{siemDataset}}"
              }
            ]
          }
        },
        "response": []
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "response": []
    }
  ]
}
